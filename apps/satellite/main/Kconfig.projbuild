    default -1

config SAT_IMU_PORT
    int "MPU6050 I2C controller"
    range 0 1
    default 0

config SAT_TILT_LIMIT_DEG
    int "Maximum tilt from configured gravity direction"
    range 5 85
    default 45

config SAT_GRAVITY_X_MG
    int "Expected stable gravity direction X (mg)"
    range -1000 1000
    default 0

config SAT_GRAVITY_Y_MG
    int "Expected stable gravity direction Y (mg)"
    range -1000 1000
    default 0

config SAT_GRAVITY_Z_MG
    int "Expected stable gravity direction Z (mg)"
    range -1000 1000
    default 1000

config SAT_SHOCK_MG
    int "Acceleration magnitude triggering automatic-motion fault"
    range 1100 8000
    default 2500

