menu "Shared solar input (all panels in parallel)"
config SAT_MON0_V_GPIO
    int "Voltage divider ADC1 GPIO (-1 disables)"
    range -1 39 if IDF_TARGET_ESP32
    range -1 10
    default -1

config SAT_MON0_V_UPPER
    int "Divider upper resistance ohm"
    range 0 10000000
    default 30000

config SAT_MON0_V_LOWER
    int "Divider lower resistance ohm"
    range 1 10000000
    default 10000

config SAT_MON0_I_GPIO
    int "Analog current sensor output ADC1 GPIO (-1 disables)"
    range -1 39 if IDF_TARGET_ESP32
    range -1 10
    default -1

config SAT_MON0_I_UPPER
    int "Divider upper resistance ohm"
    range 0 10000000
    default 0

config SAT_MON0_I_LOWER
    int "Divider lower resistance ohm"
    range 1 10000000
    default 10000

config SAT_MON0_ZERO_MV
    int "Current sensor output at zero current (mV)"
    range 0 30000
    default 0

config SAT_MON0_MV_PER_A
    int "Current sensor sensitivity (mV/A)"
    range 1 100000
    default 1000

endmenu
