menu "Satellite hardware and policies"
config SAT_SERVO_AUTO_RELEASE_MS
    int "Release servo PWM after idle target hold (ms, 0 keeps PWM enabled)"
    range 0 600000
    default 1000
    help
        After the final angle command, keep its PWM for this settling time, then
        drive the signal low. Smooth moves finish before this hold starts.
        This is a timed release, not feedback that the shaft reached its target.
        Released servos do not provide powered holding torque.

menu "Antenna"
config SAT_AXIS0_GPIO
    int "PWM GPIO (-1 disables)"
    range -1 48
    default -1

config SAT_AXIS0_REVERSED
    bool "Reverse antenna rotation direction"
    default n

config SAT_AXIS0_MAX
    int "Calibrated maximum degrees"
    range 1 360
    default 180

config SAT_AXIS0_MIN_US
    int "Minimum calibrated pulse us"
    range 100 5000
    default 500

config SAT_AXIS0_MAX_US
    int "Maximum calibrated pulse us"
    range 100 5000
    default 2500

endmenu
