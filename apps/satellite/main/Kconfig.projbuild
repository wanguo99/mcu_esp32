config SAT_BAT_LOW_MV
    int "Battery low threshold (verify battery chemistry)"
    range 100 60000
    default 3300

config SAT_BAT_RECOVER_MV
    int "Battery recovery threshold"
    range 100 60000
    default 3600

config SAT_SOLAR_BOOT_SCAN
    bool "Scan left then right once after first valid shared solar sample"
    default y

config SAT_SOLAR_LOW_MV
    int "Solar voltage triggering a new scan after three low samples (mV)"
    range 0 100000
    default 4000

config SAT_SOLAR_RECOVER_MV
    int "Solar recovery voltage to rearm low-voltage triggering (mV)"
    range 1 100000
    default 4500

config SAT_SOLAR_COOLDOWN_S
    int "Minimum interval after a completed solar scan (seconds)"
    range 10 86400
    default 300
    help
        This is a cooldown, not a periodic scan timer. Persistent low voltage
        triggers only once until the voltage recovers above the rearm threshold.

config SAT_SEARCH_SETTLE_MS
    int "Settle after movement before measurements"
    range 100 5000
    default 500

config SAT_AUTO_INTERVAL_S
    int "Minimum interval after a completed antenna automatic scan (seconds)"
    range 10 86400
    default 300
    help
        Cooldown for weak-signal triggering, not a periodic scan timer.

config SAT_ANTENNA_LOW_DBM
    int "Trigger antenna scan below this RSSI (dBm, three samples)"
    range -126 -1
    default -75

config SAT_ANTENNA_RECOVER_DBM
    int "RSSI recovery threshold to rearm scanning (dBm)"
    range -125 0
    default -65

config SAT_IMU_SDA
