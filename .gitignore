# ESP-IDF generated files (defaults are tracked)
/build/
/logs/
sdkconfig
sdkconfig.old
managed_components/
/apps/*/build/

# Machine-specific editor settings
/.vscode/
/.idea/
__pycache__/
*.pyc

# Local Wi-Fi credentials
/docs/passwd.dfts

# Third-party installers bundled with board reference materials
/docs/**/*.exe
/docs/**/*.apk
