get_filename_component(MCU_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(IDF_TARGET esp32s3 CACHE STRING "Target chip")
set(MCU_BOARD "${MCU_DEFAULT_BOARD}" CACHE STRING "Board directory under boards/")
set(MCU_MODULES "defaults" CACHE STRING "defaults, or comma/semicolon separated modules")
if(NOT MCU_BOARD MATCHES "^[A-Za-z0-9_]+$")
    message(FATAL_ERROR "Invalid MCU_BOARD")
endif()
set(MCU_BOARD_DIR "${MCU_ROOT}/boards/${MCU_BOARD}")
if(NOT EXISTS "${MCU_BOARD_DIR}/board.cmake")
    message(FATAL_ERROR "Unknown board: ${MCU_BOARD}")
endif()
include("${MCU_BOARD_DIR}/board.cmake")
if(MCU_MODULES STREQUAL "defaults")
    set(selected_modules "${MCU_DEFAULT_MODULES}")
else()
    string(REPLACE "," ";" selected_modules "${MCU_MODULES}")
endif()
set(known_modules network web camera storage recording servo)
foreach(module IN LISTS selected_modules)
    if(NOT module IN_LIST known_modules)
        message(FATAL_ERROR "Unknown module '${module}'; choose from ${known_modules}")
    endif()
endforeach()
if(recording IN_LIST selected_modules)
    list(APPEND selected_modules camera storage)
endif()
if(web IN_LIST selected_modules)
    list(APPEND selected_modules network)
endif()
list(REMOVE_DUPLICATES selected_modules)
if(camera IN_LIST selected_modules AND NOT MCU_BOARD_HAS_CAMERA)
    message(FATAL_ERROR "${MCU_BOARD} has no camera mapping; add a wired-camera board profile first")
endif()
if(storage IN_LIST selected_modules AND NOT MCU_BOARD_HAS_SD)
    message(FATAL_ERROR "${MCU_BOARD} has no SD card mapping")
endif()
set(module_kconfig "")
foreach(module IN LISTS known_modules)
    string(TOUPPER "${module}" symbol)
    if(module IN_LIST selected_modules)
        set(enabled y)
    else()
        set(enabled n)
    endif()
    string(APPEND module_kconfig "config MCU_ENABLE_${symbol}\n    bool\n    default ${enabled}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/mcu_selection/Kconfig.projbuild" CONTENT "${module_kconfig}" @ONLY)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/mcu_selection/CMakeLists.txt" CONTENT "idf_component_register()\n" @ONLY)
set(COMPONENTS main board app_config settings runtime mcu_selection ${selected_modules})
if(camera IN_LIST selected_modules AND web IN_LIST selected_modules)
    list(APPEND COMPONENTS monitor_web)
endif()
set(EXTRA_COMPONENT_DIRS "${MCU_APP_DIR}/main" "${CMAKE_BINARY_DIR}/mcu_selection")
foreach(component IN LISTS COMPONENTS)
    if(EXISTS "${MCU_ROOT}/components/${component}/CMakeLists.txt")
        list(APPEND EXTRA_COMPONENT_DIRS "${MCU_ROOT}/components/${component}")
    endif()
endforeach()
set(COMPONENT_DIRS "$ENV{IDF_PATH}/components" ${EXTRA_COMPONENT_DIRS})
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/mcu_partition.defaults"
    CONTENT "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"${MCU_BOARD_DIR}/partitions.csv\"\n" @ONLY)
set(module_defaults "")
if(web IN_LIST selected_modules)
    set(module_defaults "CONFIG_LWIP_MAX_SOCKETS=32\nCONFIG_HTTPD_WS_SUPPORT=y\n")
endif()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/mcu_module.defaults" CONTENT "${module_defaults}" @ONLY)
set(SDKCONFIG_DEFAULTS "${MCU_ROOT}/config/sdkconfig.defaults;${MCU_BOARD_DIR}/sdkconfig.defaults;${CMAKE_BINARY_DIR}/mcu_module.defaults;${MCU_APP_DIR}/sdkconfig.defaults")
if(network IN_LIST selected_modules AND EXISTS "${MCU_APP_DIR}/network.defaults")
    list(APPEND SDKCONFIG_DEFAULTS "${MCU_APP_DIR}/network.defaults")
endif()
list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_BINARY_DIR}/mcu_partition.defaults")
if(NOT DEFINED SDKCONFIG)
    set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig")
endif()
message(STATUS "MCU app=${MCU_APP}, board=${MCU_BOARD}, modules=${selected_modules}")
include($ENV{IDF_PATH}/tools/cmake/project.cmake)
idf_build_set_property(DEPENDENCIES_LOCK "${CMAKE_BINARY_DIR}/dependencies.lock")
