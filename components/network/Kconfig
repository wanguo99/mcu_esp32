menu "Network configuration"

config CAM_WIFI_AP_SSID
    string "Access point SSID"
    default "ESP32-Device"

config CAM_WIFI_AP_PASSWORD
    string "Access point password"
    default "esp32setup"
    help
        Leave empty for an open access point, or configure an 8 to 63
        character password to enable WPA2-PSK for production deployments.

config MCU_WIFI_STA_SSID
    string "Optional station SSID (empty keeps AP only)"
    default ""
config MCU_WIFI_STA_PASSWORD
    string "Station password"
    default ""
    help
        Stored in the compiled firmware. Do not commit private sdkconfig files.

config MCU_WIFI_STA_STATIC_IP
    bool "Use a static station IPv4 address"
    default n

if MCU_WIFI_STA_STATIC_IP
config MCU_WIFI_STA_STATIC_SSID
    string "Apply static IPv4 only to this SSID (empty applies to configured station)"
    default ""
    help
        A different configured station SSID uses DHCP. This keeps a saved
        deployment's address from being applied to an unrelated network.

config MCU_WIFI_STA_IP
    string "Station IPv4 address"
    default "192.168.1.100"

config MCU_WIFI_STA_NETMASK
    string "Station subnet mask"
    default "255.255.255.0"

config MCU_WIFI_STA_GATEWAY
    string "Station gateway"
    default "192.168.1.1"

config MCU_WIFI_STA_DNS
    string "Station main DNS server"
    default "192.168.1.1"
endif
endmenu
